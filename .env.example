# Copy names only — real values go in Vercel → Settings → Environment Variables. Never commit real keys.

# Set automatically when you add a Neon database from Vercel → Storage
DATABASE_URL=

# From console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# From dashboard.stripe.com → Developers → API keys (use the test key until Week 4)
STRIPE_SECRET_KEY=

# Optional: Stripe webhook signing secret (Developers → Webhooks → your endpoint)
STRIPE_WEBHOOK_SECRET=

# Optional: monthly price in cents (default 2900 = $29). Set to 100 for the Week 4 $1 live charge.
STRIPE_PRICE_CENTS=

# Optional: any long random string. If unset, one is derived from DATABASE_URL.
SESSION_SECRET=

# Optional: override the AI model (default claude-haiku-5-5)
AI_MODEL=
